{
  "name": "efatura-goruntuleyici",
  "version": "0.2.0",
  "private": true,
  "description": "e-Fatura / e-Arşiv / e-İrsaliye (UBL-TR) XML dosyalarını gömülü XSLT şablonuyla gösteren tarayıcı uzantısı (Chrome, Firefox).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emcekare/efatura-goruntuleyici.git"
  },
  "homepage": "https://github.com/emcekare/efatura-goruntuleyici#readme",
  "bugs": {
    "url": "https://github.com/emcekare/efatura-goruntuleyici/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/uctan-uca.mjs",
    "ornekler": "node araclar/ornek-uret.mjs",
    "simgeler": "node araclar/simge-uret.mjs",
    "lint:firefox": "web-ext lint --source-dir uzanti",
    "paketle": "node araclar/paketle.mjs",
    "firefox": "node araclar/paketle.mjs && web-ext run --source-dir dist/firefox",
    "imzala:firefox": "node araclar/paketle.mjs && web-ext sign --source-dir dist/firefox --channel unlisted --artifacts-dir dist/imzali"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "jsqr": "1.4.0",
    "playwright-core": "1.58.2",
    "pngjs": "7.0.0",
    "web-ext": "10.8.0"
  }
}
